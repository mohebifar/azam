@@ -0,0 +1,206 @@
+//! Arabic-script shaping: letters take their contextual form (isolated, final, initial, medial)
+//! as Unicode presentation forms, so a font without a shaping engine draws joined text. Covers
+//! Arabic and the Persian letters (پ چ ژ گ ک ی ۀ), lam-alef ligatures, transparent marks and
+//! the zero-width non-joiner. Runs on logical-order text, before bidi reordering.
+
+/// How a letter joins its neighbours.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum Join {
+    /// Joins on both sides.
+    Dual,
+    /// Joins only to the letter before it (alef, dal, reh, waw …).
+    Right,
+    /// Joins both neighbours without changing shape (tatweel).
+    Causing,
+    /// Never joins.
+    None,
+    /// Marks: ignored when deciding joins.
+    Transparent,
+}
+
+/// Presentation forms of a letter: isolated, final, initial, medial (0 = no such form).
+struct Forms {
+    letter: u32,
+    join: Join,
+    forms: [u32; 4],
+}
+
+const fn dual(letter: u32, base: u32) -> Forms {
+    Forms { letter, join: Join::Dual, forms: [base, base + 1, base + 2, base + 3] }
+}
+
+const fn right(letter: u32, base: u32) -> Forms {
+    Forms { letter, join: Join::Right, forms: [base, base + 1, 0, 0] }
+}
+
+const FORMS: &[Forms] = &[
+    Forms { letter: 0x0621, join: Join::None, forms: [0xFE80, 0, 0, 0] },
+    right(0x0622, 0xFE81),
+    right(0x0623, 0xFE83),
+    right(0x0624, 0xFE85),
+    right(0x0625, 0xFE87),
+    dual(0x0626, 0xFE89),
+    right(0x0627, 0xFE8D),
+    dual(0x0628, 0xFE8F),
+    right(0x0629, 0xFE93),
+    dual(0x062A, 0xFE95),
+    dual(0x062B, 0xFE99),
+    dual(0x062C, 0xFE9D),
+    dual(0x062D, 0xFEA1),
+    dual(0x062E, 0xFEA5),
+    right(0x062F, 0xFEA9),
+    right(0x0630, 0xFEAB),
+    right(0x0631, 0xFEAD),
+    right(0x0632, 0xFEAF),
+    dual(0x0633, 0xFEB1),
+    dual(0x0634, 0xFEB5),
+    dual(0x0635, 0xFEB9),
+    dual(0x0636, 0xFEBD),
+    dual(0x0637, 0xFEC1),
+    dual(0x0638, 0xFEC5),
+    dual(0x0639, 0xFEC9),
+    dual(0x063A, 0xFECD),
+    Forms { letter: 0x0640, join: Join::Causing, forms: [0x0640, 0x0640, 0x0640, 0x0640] },
+    dual(0x0641, 0xFED1),
+    dual(0x0642, 0xFED5),
+    dual(0x0643, 0xFED9),
+    dual(0x0644, 0xFEDD),
+    dual(0x0645, 0xFEE1),
+    dual(0x0646, 0xFEE5),
+    dual(0x0647, 0xFEE9),
+    right(0x0648, 0xFEED),
+    right(0x0649, 0xFEEF),
+    dual(0x064A, 0xFEF1),
+    dual(0x067E, 0xFB56),
+    dual(0x0686, 0xFB7A),
+    right(0x0698, 0xFB8A),
+    dual(0x06A9, 0xFB8E),
+    dual(0x06AF, 0xFB92),
+    right(0x06C0, 0xFBA4),
+    dual(0x06CC, 0xFBFC),
+];
+
+const LAM: u32 = 0x0644;
+const ZWNJ: u32 = 0x200C;
+/// Lam followed by an alef: the alef and the ligature's isolated form (final is one more).
+const LAM_ALEF: [(u32, u32); 4] = [(0x0622, 0xFEF5), (0x0623, 0xFEF7), (0x0625, 0xFEF9), (0x0627, 0xFEFB)];
+
+fn forms(c: char) -> Option<&'static Forms> {
+    let u = c as u32;
+    FORMS.binary_search_by_key(&u, |f| f.letter).ok().map(|i| &FORMS[i])
+}
+
+fn join(c: char) -> Join {
+    let u = c as u32;
+    if let Some(f) = forms(c) {
+        f.join
+    } else if matches!(u, 0x0610..=0x061A | 0x064B..=0x065F | 0x0670 | 0x06D6..=0x06ED) {
+        Join::Transparent
+    } else {
+        Join::None
+    }
+}
+
+/// Whether `s` holds Arabic-script letters that shaping changes.
+#[must_use]
+pub(crate) fn needs_shaping(s: &str) -> bool {
+    s.chars().any(|c| forms(c).is_some() || c as u32 == ZWNJ)
+}
+
+/// `chars` with every Arabic-script letter in its contextual presentation form. Zero-width
+/// non-joiners are dropped once they have done their job.
+#[must_use]
+pub(crate) fn shape(chars: &[char]) -> Vec<char> {
+    let n = chars.len();
+    // Nearest non-transparent neighbours' joining types.
+    let neighbour = |from: usize, step: isize| -> Join {
+        let mut k = from as isize + step;
+        while k >= 0 && (k as usize) < n {
+            let j = join(chars[k as usize]);
+            if j != Join::Transparent {
+                return j;
+            }
+            k += step;
+        }
+        Join::None
+    };
+    let mut out = Vec::with_capacity(n);
+    let mut k = 0;
+    while k < n {
+        let c = chars[k];
+        if c as u32 == ZWNJ {
+            k += 1;
+            continue;
+        }
+        let Some(f) = forms(c) else {
+            out.push(c);
+            k += 1;
+            continue;
+        };
+        let joins_before = matches!(neighbour(k, -1), Join::Dual | Join::Causing);
+        // lam-alef ligature
+        if f.letter == LAM {
+            let mut j = k + 1;
+            while j < n && join(chars[j]) == Join::Transparent {
+                j += 1;
+            }
+            if let Some(&(_, lig)) = chars.get(j).and_then(|a| LAM_ALEF.iter().find(|(alef, _)| *alef == *a as u32)) {
+                let form = if joins_before { lig + 1 } else { lig };
+                out.push(char::from_u32(form).unwrap_or(c));
+                out.extend(&chars[k + 1..j]);
+                k = j + 1;
+                continue;
+            }
+        }
+        let joins_after = f.join == Join::Dual && matches!(neighbour(k, 1), Join::Dual | Join::Right | Join::Causing);
+        let index = match (f.join, joins_before, joins_after) {
+            (Join::Dual | Join::Causing, true, true) => 3,
+            (Join::Dual | Join::Causing, false, true) => 2,
+            (_, true, _) => 1,
+            _ => 0,
+        };
+        let code = if f.forms[index] != 0 { f.forms[index] } else { f.forms[0] };
+        out.push(char::from_u32(code).unwrap_or(c));
+        k += 1;
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn shaped(s: &str) -> String {
+        shape(&s.chars().collect::<Vec<_>>()).into_iter().collect()
+    }
+
+    #[test]
+    fn letters_take_contextual_forms() {
+        // سلام: seen initial, lam-alef ligature (final, joined to the seen), meem isolated
+        assert_eq!(shaped("سلام"), "\u{FEB3}\u{FEFC}\u{FEE1}");
+    }
+
+    #[test]
+    fn persian_letters_join() {
+        // پیش: peh initial, farsi yeh medial, sheen final
+        assert_eq!(shaped("پیش"), "\u{FB58}\u{FBFF}\u{FEB6}");
+    }
+
+    #[test]
+    fn right_joining_letters_break_the_chain() {
+        // دست: dal isolated (nothing before), seen initial, teh final
+        assert_eq!(shaped("دست"), "\u{FEA9}\u{FEB3}\u{FE96}");
+    }
+
+    #[test]
+    fn zwnj_stops_joining_and_disappears() {
+        // می‌روم: meem initial, yeh final, (zwnj), reh isolated, waw final? no: reh isolated, waw isolated, meem isolated
+        assert_eq!(shaped("می\u{200C}روم"), "\u{FEE3}\u{FBFD}\u{FEAD}\u{FEED}\u{FEE1}");
+    }
+
+    #[test]
+    fn latin_text_is_untouched() {
+        assert_eq!(shaped("Front 2"), "Front 2");
+        assert!(!needs_shaping("Front 2"));
+    }
+}
