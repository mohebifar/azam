+/// Every icon name the kit draws: Blender's SVG icons, then BUI's own vector icons.
+/// Pass one to [`Image::icon`].
+pub fn icon_names() -> impl Iterator<Item = &'static str> {
+    // SAFETY: a constant query.
+    let n = unsafe { sys::BK_icon_list_count() };
+    (0..n).filter_map(|i| {
+        // SAFETY: `i` is in range; the kit returns static NUL-terminated strings.
+        let p = unsafe { sys::BK_icon_list_name(i) };
+        (!p.is_null()).then(|| unsafe { std::ffi::CStr::from_ptr(p) }.to_str().ok()).flatten()
+    })
+}
+
+/// What a [`file_dialog`] is for.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum FileDialogMode {
+    /// Choose existing files.
+    Open,
+    /// Choose a file name to write.
+    Save,
+    /// Choose a folder.
+    Directory,
+}
+
+/// The outcome of a [`file_dialog`].
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum FileDialogResult {
+    /// The chosen paths.
+    Chosen(Vec<std::path::PathBuf>),
+    /// The user cancelled.
+    Cancelled,
+    /// No native window host (headless): the app must ask some other way.
+    Unavailable,
+}
+
+/// Runs Blender's File Browser in its own window until the user answers. `filters` are
+/// `"Label\tpattern pattern"` entries (`"Projects\t*.azam.json"`).
+pub fn file_dialog(
+    title: &str,
+    mode: FileDialogMode,
+    dir: Option<&std::path::Path>,
+    file: Option<&str>,
+    filters: &[&str],
+    multiple: bool,
+) -> FileDialogResult {
+    use std::ffi::{CStr, CString};
+    let cstring = |s: &str| CString::new(s.replace('\0', "")).unwrap_or_default();
+    let title = cstring(title);
+    let dir = dir.map(|d| cstring(&d.to_string_lossy()));
+    let file = file.map(cstring);
+    let filters: Vec<CString> = filters.iter().map(|f| cstring(f)).collect();
+    let filter_ptrs: Vec<*const std::ffi::c_char> = filters.iter().map(|f| f.as_ptr()).collect();
+    let mode = match mode {
+        FileDialogMode::Open => 0,
+        FileDialogMode::Save => 1,
+        FileDialogMode::Directory => 2,
+    };
+    let mut paths: *mut *mut std::ffi::c_char = std::ptr::null_mut();
+    // SAFETY: every pointer is NUL-terminated and outlives the call; the kit allocates `paths`,
+    // which is freed below with its own free function.
+    let n = unsafe {
+        sys::BK_file_dialog(
+            title.as_ptr(),
+            mode,
+            dir.as_ref().map_or(std::ptr::null(), |d| d.as_ptr()),
+            file.as_ref().map_or(std::ptr::null(), |f| f.as_ptr()),
+            filter_ptrs.as_ptr(),
+            filter_ptrs.len() as i32,
+            i32::from(multiple),
+            &raw mut paths,
+        )
+    };
+    if n < 0 {
+        return FileDialogResult::Unavailable;
+    }
+    if n == 0 || paths.is_null() {
+        return FileDialogResult::Cancelled;
+    }
+    let mut out = Vec::with_capacity(n as usize);
+    for i in 0..n as usize {
+        // SAFETY: the kit returned `n` NUL-terminated strings in a NULL-terminated array.
+        let p = unsafe { *paths.add(i) };
+        if p.is_null() {
+            break;
+        }
+        // SAFETY: as above.
+        out.push(std::path::PathBuf::from(unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()));
+    }
+    // SAFETY: `paths` came from BK_file_dialog.
+    unsafe { sys::BK_file_dialog_free(paths) };
+    FileDialogResult::Chosen(out)
+}
+
